# Use the zoompilot opendbc fork. Changes to this file make submodule sync refresh
# legacy URLs.
[submodule "panda"]
  path = panda
  url = https://github.com/surispace/panda.git
[submodule "opendbc"]
  path = opendbc_repo
  url = https://github.com/surispace/opendbc.git
[submodule "msgq"]
  path = msgq_repo
  url = https://github.com/surispace/msgq.git
[submodule "rednose_repo"]
  path = rednose_repo
  url = https://github.com/surispace/rednose.git
[submodule "teleoprtc_repo"]
  path = teleoprtc_repo
  url = https://github.com/surispace/teleoprtc.git
[submodule "tinygrad"]
  path = tinygrad_repo
  url = https://github.com/surispace/tinygrad.git
[submodule "sunnypilot/neural_network_data"]
  path = openpilot/sunnypilot/neural_network_data
  url = https://github.com/surispace/neural-network-data.git
[submodule "jetlink"]
  path = jetlink_repo
  url = https://github.com/surispace/jetlink.git
