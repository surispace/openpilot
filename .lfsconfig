[lfs]
	url = https://github.com/surispace/openpilot.git/info/lfs
	pushurl = ssh://git@github.com/surispace/openpilot.git
	locksverify = false
	# Only a chestnut uses the big driving model. Keep its pointer but exclude the object from
	# install fetches, reducing the LFS payload from about 1974 MB to 174 MB; a chestnut build
	# fetches it (openpilot/sunnypilot/models/big_model_source.py).
	fetchexclude = openpilot/selfdrive/modeld/models/big_driving_supercombo.onnx
